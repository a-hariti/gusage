{
  "name": "gusage",
  "version": "1.2.1",
  "description": "A standalone CLI to export Gemini CLI quota and usage statistics",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "gusage": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "author": "Abdellah Hariti <haritiabdellah@gmail.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "format": "prettier --write .",
    "prepare": "husky",
    "build": "bun build ./index.ts --outfile dist/index.js && chmod +x dist/index.js",
    "prepack": "bun run build"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.ts": "bash -c 'bun x tsc --noEmit'"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "keywords": [
    "gemini-cli",
    "gemini",
    "google-gemini",
    "quota",
    "usage",
    "stats",
    "monitoring"
  ]
}
